{
  "name": "youtube-shorts-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "YouTube Shorts на Remotion: наука / космос / мозг. Вертикаль 1080x1920, процедурная анимация, караоке-субтитры, AI-озвучка.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
